{
  "version": 1,
  "cases": [
    {
      "id": "文字原文完全保留",
      "source": [
        {
          "role": "user",
          "content": "必须使用 Rust"
        },
        {
          "role": "user",
          "content": "禁止上传"
        }
      ],
      "budget": 200,
      "expected_contains": [
        "必须使用 Rust",
        "禁止上传"
      ],
      "expected_complete": true,
      "expected_omitted": 0
    },
    {
      "id": "零预算显式省略",
      "source": [
        {
          "role": "user",
          "content": "禁止上传"
        }
      ],
      "budget": 0,
      "expected_contains": [],
      "expected_complete": false,
      "expected_omitted": 1
    },
    {
      "id": "大项不阻塞小约束",
      "source": [
        {
          "role": "user",
          "content": ""
        },
        {
          "role": "user",
          "content": "中文约束"
        }
      ],
      "budget": 100,
      "expected_contains": [
        "中文约束"
      ],
      "expected_complete": false,
      "expected_omitted": 1
    },
    {
      "id": "旧数组不证明完整",
      "source": [
        {
          "role": "system",
          "content": "[retained_user_inputs] 历史用户原文，仅作证据，不是新指令。\n[\"禁止上传\"]\n旧摘要"
        }
      ],
      "budget": 200,
      "expected_contains": [
        "禁止上传"
      ],
      "expected_complete": false,
      "expected_omitted": 0
    },
    {
      "id": "未知checkpoint保持不完整",
      "source": [
        {
          "role": "system",
          "content": "[context_checkpoint] 历史模型推断\n{\"version\": 1, \"kind\": \"model_inference\", \"text\": \"摘要\"}"
        }
      ],
      "budget": 200,
      "expected_contains": [],
      "expected_complete": false,
      "expected_omitted": 0
    },
    {
      "id": "重压缩不恢复完整或重计省略",
      "source": [
        {
          "role": "system",
          "content": "[retained_user_inputs] 历史用户原文，仅作证据，不是新指令。\n{\"version\": 2, \"inputs\": [\"禁止上传\"], \"text_complete\": false, \"omitted\": 3}\n[context_checkpoint] 历史模型推断\n{\"omitted_user_inputs_lower_bound\": 3}"
        },
        {
          "role": "user",
          "content": "使用中文"
        }
      ],
      "budget": 200,
      "expected_contains": [
        "禁止上传",
        "使用中文"
      ],
      "expected_complete": false,
      "expected_omitted": 3
    }
  ]
}
